{
  "name": "dsh-message-copy-enhance",
  "version": "0.2.1",
  "description": "Copy dsh assistant output as Markdown, preserving links, LaTeX sources and code fences.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "client-plugin",
    "markdown",
    "copy",
    "clipboard",
    "latex"
  ],
  "license": "MIT",
  "author": "Asianfleet <wangjianqing25@mails.ucas.ac.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asianfleet/dsh-message-copy-enhance.git"
  },
  "bugs": {
    "url": "https://github.com/Asianfleet/dsh-message-copy-enhance/issues"
  },
  "homepage": "https://github.com/Asianfleet/dsh-message-copy-enhance#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "src",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README_zh.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test",
    "check:release": "npm run check && node scripts/check-release.mjs",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "katex": "0.16.47",
    "linkedom": "^0.18.0",
    "release-it": "^21.0.2",
    "semver": "^7.8.5",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
